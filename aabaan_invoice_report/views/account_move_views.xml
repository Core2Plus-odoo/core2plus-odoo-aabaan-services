<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_aabaan_audit_trail" model="ir.ui.view">
        <field name="name">account.move.form.aabaan.audit.trail</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//notebook" position="inside">
                <page string="Document Audit Trail" name="aabaan_audit_trail"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="aabaan_audit_trail_html" widget="html" readonly="1" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
