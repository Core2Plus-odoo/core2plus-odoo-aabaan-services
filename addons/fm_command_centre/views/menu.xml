<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_command_centre" model="ir.actions.client">
        <field name="name">CEO Dashboard</field>
        <field name="tag">fm_command_centre</field>
    </record>

    <record id="action_command_centre_compact" model="ir.actions.client">
        <field name="name">CEO Dashboard (8 sections)</field>
        <field name="tag">fm_command_centre</field>
        <field name="params" eval="{'variant': 'compact'}"/>
    </record>

    <!-- Standard "module,path" web_icon. The crash noted in fm_asset was a
         malformed path; a real file in this module's static/ loads fine. -->
    <menuitem id="menu_command_centre_root"
              name="CEO Dashboard"
              sequence="5"
              web_icon="fm_command_centre,static/description/icon.png"
              groups="fm_command_centre.group_command_centre_viewer"/>

    <menuitem id="menu_command_centre_dashboard"
              name="CEO Dashboard"
              parent="menu_command_centre_root"
              action="action_command_centre"
              sequence="1"/>

    <menuitem id="menu_command_centre_dashboard_compact"
              name="CEO Summary"
              parent="menu_command_centre_root"
              action="action_command_centre_compact"
              sequence="2"/>

    <menuitem id="menu_command_centre_config"
              name="Configuration"
              parent="menu_command_centre_root"
              sequence="90"
              groups="base.group_system,account.group_account_manager"/>

    <menuitem id="menu_cc_branch_targets"
              name="Branch Targets"
              parent="menu_command_centre_config"
              action="action_cc_branch_targets"
              sequence="10"/>

    <menuitem id="menu_cc_sales_targets"
              name="Sales Team Targets"
              parent="menu_command_centre_config"
              action="action_cc_sales_targets"
              sequence="20"/>

    <menuitem id="menu_cc_budget"
              name="Budget"
              parent="menu_command_centre_config"
              action="action_cc_budget"
              sequence="25"/>

    <menuitem id="menu_cc_products"
              name="Service Classification"
              parent="menu_command_centre_config"
              action="action_cc_products"
              sequence="30"/>

    <menuitem id="menu_cc_invoices"
              name="Invoice Classification"
              parent="menu_command_centre_config"
              action="action_cc_invoices"
              sequence="40"/>

    <menuitem id="menu_cc_settings"
              name="Dashboard Settings"
              parent="menu_command_centre_config"
              action="action_cc_settings"
              sequence="50"/>

</odoo>
