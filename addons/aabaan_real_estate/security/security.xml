<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Who sees the Real Estate app: only users given one of these roles. -->
    <record id="module_category_re" model="ir.module.category">
        <field name="name">Real Estate</field>
        <field name="sequence">40</field>
    </record>
    <record id="privilege_re" model="res.groups.privilege">
        <field name="name">Real Estate</field>
        <field name="category_id" ref="module_category_re"/>
    </record>
    <record id="group_re_user" model="res.groups">
        <field name="name">Agent</field>
        <field name="privilege_id" ref="privilege_re"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_re_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_re"/>
        <field name="implied_ids" eval="[(4, ref('group_re_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="re_project_company_rule" model="ir.rule">
        <field name="name">Real estate project: multi-company</field>
        <field name="model_id" ref="model_re_project"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="re_unit_company_rule" model="ir.rule">
        <field name="name">Real estate unit: multi-company</field>
        <field name="model_id" ref="model_re_unit"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
