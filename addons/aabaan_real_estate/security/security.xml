<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="re_project_company_rule" model="ir.rule">
        <field name="name">Real estate project: multi-company</field>
        <field name="model_id" ref="model_re_project"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="re_unit_company_rule" model="ir.rule">
        <field name="name">Real estate unit: multi-company</field>
        <field name="model_id" ref="model_re_unit"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
