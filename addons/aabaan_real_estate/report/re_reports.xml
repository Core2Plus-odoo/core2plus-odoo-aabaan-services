<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_re" model="report.paperformat">
        <field name="name">Real estate A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>
    <record id="action_report_re_proposal" model="ir.actions.report">
        <field name="name">Property proposal</field>
        <field name="model">crm.lead</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aabaan_real_estate.report_re_proposal</field>
        <field name="report_file">aabaan_real_estate.report_re_proposal</field>
        <field name="print_report_name">'Proposal - %s' % (object.partner_name or object.contact_name or object.name)</field>
        <field name="paperformat_id" ref="paperformat_re"/>
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="action_report_re_compare" model="ir.actions.report">
        <field name="name">Project comparison</field>
        <field name="model">re.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aabaan_real_estate.report_re_compare</field>
        <field name="report_file">aabaan_real_estate.report_re_compare</field>
        <field name="print_report_name">'Project - %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_re"/>
        <field name="binding_model_id" ref="model_re_project"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
