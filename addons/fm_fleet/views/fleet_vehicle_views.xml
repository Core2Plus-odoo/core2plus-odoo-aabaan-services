<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_fm" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.fm</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Branch &amp; Renewals" name="fm_renewals">
                    <group>
                        <field name="fm_branch_id"/>
                    </group>
                    <group>
                        <field name="fm_registration_expiry"/>
                        <field name="fm_insurance_expiry"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_tree_fm" model="ir.ui.view">
        <field name="name">fleet.vehicle.list.fm</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="fm_branch_id" optional="show"/>
                <field name="fm_registration_expiry" optional="show"/>
                <field name="fm_insurance_expiry" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
