<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The Emirate analytic accounts are the branches: carry each
         branch's own trade licence on the record itself. -->
    <record id="view_analytic_account_form_licence" model="ir.ui.view">
        <field name="name">account.analytic.account.form.aabaan.branch</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='plan_id']" position="after">
                <field name="aabaan_licence_no"/>
                <field name="aabaan_licence_expiry"/>
            </xpath>
        </field>
    </record>

    <record id="view_analytic_account_list_licence" model="ir.ui.view">
        <field name="name">account.analytic.account.list.aabaan.branch</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='plan_id']" position="after">
                <field name="aabaan_licence_no" optional="hide"/>
                <field name="aabaan_licence_expiry" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Branch on the contract. -->
    <record id="view_order_form_branch" model="ir.ui.view">
        <field name="name">sale.order.form.aabaan.branch</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="aabaan_branch_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_list_branch" model="ir.ui.view">
        <field name="name">sale.order.list.aabaan.branch</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="aabaan_branch_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_branch" model="ir.ui.view">
        <field name="name">sale.order.search.aabaan.branch</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <field name="aabaan_branch_id"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_aabaan_branch" string="Branch"
                        context="{'group_by': 'aabaan_branch_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
