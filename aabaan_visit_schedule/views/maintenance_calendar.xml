<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Date-only maintenance calendar: events carry no clock time, so the
         client name (which leads the visit name) is what shows on the tile. -->
    <record id="view_task_visit_calendar_dateonly" model="ir.ui.view">
        <field name="name">aabaan.visit.calendar.dateonly</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <calendar date_start="visit_date" color="stage_id" mode="month"
                      quick_create="0" event_open_popup="1">
                <field name="partner_id"/>
                <field name="stage_id"/>
                <field name="user_ids"/>
            </calendar>
        </field>
    </record>

    <record id="action_maintenance_calendar_dateonly" model="ir.actions.act_window">
        <field name="name">Maintenance Calendar</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="view_id" ref="view_task_visit_calendar_dateonly"/>
        <field name="domain">[('project_id.is_fsm', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No visits scheduled yet</p>
            <p>Confirm an AMC contract with a visit count and the schedule
               generates automatically.</p>
        </field>
    </record>

    <menuitem id="menu_maintenance_calendar_dateonly"
              name="Maintenance Calendar"
              parent="industry_fsm.fsm_menu_root"
              action="aabaan_visit_schedule.action_maintenance_calendar_dateonly"
              sequence="6"/>
</odoo>
