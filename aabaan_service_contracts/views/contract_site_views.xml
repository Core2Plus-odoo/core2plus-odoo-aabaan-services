<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_site_list_embed" model="ir.ui.view">
        <field name="name">aabaan.contract.site.list.embed</field>
        <field name="model">aabaan.contract.site</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="status == 'suspended'"
                  decoration-warning="status == 'review'">
                <field name="site_id" domain="[('id', 'child_of', parent.partner_id)]"/>
                <field name="service_tag_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
                <field name="frequency"/>
                <field name="sla_response_target"/>
                <field name="visit_count_ytd" optional="show"/>
                <field name="uptime_ytd" widget="percentage" optional="show"/>
                <field name="site_value" sum="Total"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-warning="status == 'review'"
                       decoration-muted="status == 'suspended'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Standalone list for the Sites smart button — no parent.* domain,
         which the embedded list needs but a standalone view cannot carry. -->
    <record id="view_contract_site_list_full" model="ir.ui.view">
        <field name="name">aabaan.contract.site.list.full</field>
        <field name="model">aabaan.contract.site</field>
        <field name="arch" type="xml">
            <list decoration-muted="status == 'suspended'"
                  decoration-warning="status == 'review'">
                <field name="order_id"/>
                <field name="site_id"/>
                <field name="service_tag_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
                <field name="frequency"/>
                <field name="sla_response_target"/>
                <field name="visit_count_ytd"/>
                <field name="uptime_ytd" widget="percentage"/>
                <field name="site_value" sum="Total"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-warning="status == 'review'"
                       decoration-muted="status == 'suspended'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_service_tag_list" model="ir.ui.view">
        <field name="name">aabaan.service.tag.list</field>
        <field name="model">aabaan.service.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_service_tags" model="ir.actions.act_window">
        <field name="name">Service Tags</field>
        <field name="res_model">aabaan.service.tag</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_service_tags" name="Service Tags"
              parent="sale.sale_menu_root"
              action="action_service_tags" sequence="20"/>
</odoo>
