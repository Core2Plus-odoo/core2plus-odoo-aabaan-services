<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contract side panel on the customer invoice (approved UI screens).
         Payment status widget and the chatter audit trail are native and
         already on the form — this page adds the contract context. -->
    <record id="view_move_form_aabaan_cockpit" model="ir.ui.view">
        <field name="name">account.move.form.aabaan.cockpit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//notebook" position="inside">
                <page string="Contract Cockpit" name="aabaan_cockpit"
                      invisible="not aabaan_order_id">
                    <group>
                        <group string="Contract">
                            <field name="aabaan_order_id" readonly="1"/>
                            <field name="aabaan_end_date" readonly="1"/>
                            <field name="aabaan_renewal_state" readonly="1"/>
                        </group>
                        <group string="Delivery">
                            <field name="aabaan_visits_done" readonly="1"/>
                            <field name="aabaan_visits_total" readonly="1"/>
                            <field name="aabaan_visits_overdue" readonly="1"/>
                        </group>
                        <group string="Health &amp; Money">
                            <field name="aabaan_health" readonly="1"/>
                            <field name="aabaan_health_note" readonly="1"/>
                            <field name="aabaan_outstanding" readonly="1"/>
                        </group>
                    </group>
                    <button name="action_open_contract" type="object"
                            string="Open Contract Cockpit" class="btn btn-primary"
                            invisible="not aabaan_order_id"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
